# Supabase 연결 (dental-report 와 동일 프로젝트 사용)
# get-secret.cmd 헬퍼로 받아 채워 넣기:
#   Z:\web\.claude-setup\credentials\get-secret.cmd supabase.projects.offapp.url
#   Z:\web\.claude-setup\credentials\get-secret.cmd supabase.projects.offapp.service_role_key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude Code OAuth 토큰 — Max 구독 인증
# 발급:
#   PC2 에서 한 번만:  claude setup-token
#   →  ~/.claude/.credentials.json 에 저장됨
#   →  여기 환경변수로 빼서 둠 (Agent SDK 가 읽음)
# 또는 인증된 PC2 라면 이 변수 비워두고 Agent SDK 가 ~/.claude 에서 자동 로드함
CLAUDE_CODE_OAUTH_TOKEN=

# 워커 식별자 (어느 PC2 인지 구분 — 로그·디버깅용)
WORKER_ID=pc2-main

# 모델 선택 (composeReport 와 패턴 분석에 모두 사용)
# claude-sonnet-4-6 권장, 패턴분석은 claude-opus-4-7 옵션
COMPOSE_MODEL=claude-sonnet-4-6
ANALYZE_MODEL=claude-sonnet-4-6
